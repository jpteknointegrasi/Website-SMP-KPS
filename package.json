{
  "name": "sekolahku",
  "private": true,
  "description": "Sekolahku: Sekolahku Web (website & CMS, apps/web) dan Sekolahku App (portal PWA, apps/portal), dijual terpisah, di atas inti bersama (packages/core).",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @sekolahku/web",
    "dev:portal": "npm run dev -w @sekolahku/portal",
    "build": "npm run build -w @sekolahku/web",
    "build:portal": "npm run build -w @sekolahku/portal",
    "test": "npm test -w @sekolahku/core && npm test -w @sekolahku/web && npm test -w @sekolahku/portal --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "migrate": "npm run migrate -w @sekolahku/web",
    "seed": "npm run seed -w @sekolahku/web",
    "sekolah:baru": "npm run sekolah:baru -w @sekolahku/web --",
    "platform:superadmin": "npm run platform:superadmin -w @sekolahku/web --",
    "portal:migrate": "npm run migrate -w @sekolahku/portal --",
    "portal:demo": "npm run demo -w @sekolahku/portal --"
  },
  "engines": {
    "node": ">=22.12"
  }
}
