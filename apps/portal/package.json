{
  "name": "@sekolahku/portal",
  "version": "0.1.0",
  "private": true,
  "description": "Sekolahku App: portal PWA di /portal (penerimaan siswa baru, akademik, layanan). Satu database per sekolah.",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "vercel-build": "node scripts/vercel-build.mjs",
    "start": "next start -p 3001",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "migrate": "tsx scripts/migrate.ts",
    "demo": "tsx scripts/demo.ts",
    "ekspor": "tsx scripts/export.ts",
    "pulihkan": "tsx scripts/restore.ts"
  },
  "dependencies": {
    "@sekolahku/core": "*",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "0.45.2",
    "exceljs": "^4.4.0",
    "next": "16.3.3",
    "nodemailer": "^6.10.1",
    "pg": "8.20.0",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "8.20.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "dotenv": "16.4.7",
    "drizzle-kit": "0.31.7",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": ">=22.12"
  }
}
