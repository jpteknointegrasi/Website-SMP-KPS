    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "dotenv": "16.4.7",
    "drizzle-kit": "0.31.7",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": ">=22.12"
