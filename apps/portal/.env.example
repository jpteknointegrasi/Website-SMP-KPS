# Sekolahku App (portal) — deployment terpisah, dilayani di /portal pada domain setiap sekolah.

# Database platform (registri sekolah): database Sekolahku Web, lewat ROLE HANYA-BACA yang cuma boleh SELECT
# tabel tenants & tenants_domains (SQL pembuatannya: PANDUAN_PLATFORM.md §F).
PLATFORM_DATABASE_URL=

# Kunci penyegel URL database App per sekolah. WAJIB SAMA dengan PLATFORM_SECRET di Sekolahku Web.
PLATFORM_SECRET=
# Alamat langsung deployment Sekolahku Web (mis. https://sekolahku-web.vercel.app). Portal menanyakan ke website
# siapa pemilik sesi login staf; portal TIDAK menyimpan PAYLOAD_SECRET.
WEB_ORIGIN=
# Rahasia bersama dengan Sekolahku Web (≥ 16 karakter): hanya permintaan yang diteruskan website yang boleh
# membawa host sekolah. WAJIB SAMA dengan PORTAL_PROXY_SECRET di Sekolahku Web.
PORTAL_PROXY_SECRET=

# Sama seperti Sekolahku Web
PLATFORM_ROOT_DOMAIN=
# Hanya untuk pengembangan lokal. Di produksi diabaikan: portal hanya melayani permintaan yang diteruskan website.
DEFAULT_TENANT_SLUG=
PLATFORM_NAME=Platform Website Sekolah

# Berkas privat (bukti bayar, dokumen siswa, lampiran). Produksi WAJIB S3-kompatibel yang TIDAK publik
# (Cloudflare R2 / S3 / MinIO). STORAGE_DIR hanya untuk pengembangan lokal.
STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# STORAGE_DIR=./.storage

# Job terjadwal (rilis hasil/pengumuman terjadwal, antrean email): panggil GET /portal/api/jobs tiap 5–15 menit
# dengan header "Authorization: Bearer <CRON_SECRET>" (Vercel Cron atau cron eksternal).
CRON_SECRET=

# Email keluar (verifikasi akun, atur ulang sandi, notifikasi). Kosong = email hanya dicatat di log (uji).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# HANYA uji lokal lewat http: cookie tanpa atribut Secure. Jangan pernah diisi di produksi.
# PORTAL_INSECURE_COOKIES=true
