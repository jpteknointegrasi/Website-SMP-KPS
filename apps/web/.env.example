# --- wajib ---
# PostgreSQL. Contoh lokal: postgres://kps:kata-sandi@127.0.0.1:5432/kps
DATABASE_URI=
# String acak panjang (≥ 32 karakter). Contoh membuat: openssl rand -base64 48
PAYLOAD_SECRET=
# Deployment SATU sekolah saja: URL publik tanpa garis miring di akhir (mis. https://www.smpkps.sch.id).
# Platform MULTI-SEKOLAH: kosongkan (setiap sekolah memakai domainnya sendiri; lihat PANDUAN_PLATFORM.md).
# Catatan: migrasi platform membaca nilai ini sekali untuk mencatat domain sekolah pertama.
NEXT_PUBLIC_SERVER_URL=

# --- platform multi-sekolah ---
# Domain induk untuk subdomain otomatis: <kode-sekolah>.<domain ini> (DNS wildcard *.domain → Vercel). Opsional.
PLATFORM_ROOT_DOMAIN=
# Sekolah untuk alamat yang tidak dikenali (localhost, URL preview *.vercel.app). Lokal: kps. Produksi multi-sekolah: kosong.
DEFAULT_TENANT_SLUG=kps
# Nama platform di judul CMS dan halaman Super Admin
PLATFORM_NAME=Platform Website Sekolah
# Kunci penyegel rahasia platform (mis. URL database App per sekolah). Acak ≥ 32 karakter; SAMA di Satu Sekolah App.
PLATFORM_SECRET=

# --- Satu Sekolah App (portal di /portal) ---
# Alamat deployment portal (mis. https://<proyek-app>.vercel.app). Kosong = /portal tidak diteruskan.
PORTAL_ORIGIN=
# Rahasia bersama dengan portal (acak ≥ 16 karakter); SAMA di Satu Sekolah App.
PORTAL_PROXY_SECRET=

# Kode sekolah penerima paket konten awal KPS (seed & /setup/isi-data). Bawaan: kps
# SEED_TENANT_SLUG=kps

# --- produksi di Vercel (diisi otomatis oleh integrasi Storage di dashboard Vercel) ---
# DATABASE_URL=        (dari Neon; dipakai bila DATABASE_URI kosong)
# Penyimpanan berkas (wajib di Vercel). Pilihan 1 — S3-kompatibel, mis. Supabase Storage:
#   foto publik di bucket PUBLIK, dokumen & berkas privat di bucket PRIVAT (selalu lewat website)
# STORAGE_S3_ENDPOINT=https://<ref>.storage.supabase.co/storage/v1/s3
# STORAGE_S3_REGION=ap-northeast-1
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# STORAGE_S3_PUBLIC_BUCKET=sekolahku-web-media
# STORAGE_S3_PRIVATE_BUCKET=sekolahku-web-files
# STORAGE_PUBLIC_URL=https://<ref>.supabase.co/storage/v1/object/public
# Pilihan 2 — Vercel Blob (dipakai bila STORAGE_S3_* kosong; bila keduanya kosong, file disimpan di disk lokal)
# BLOB_READ_WRITE_TOKEN=

# --- konten ---
# Data contoh berlabel "Contoh". Produksi: false
SHOW_DEMO_CONTENT=false
# true = blokir mesin pencari (staging/preview)
NOINDEX=false
# true = aktifkan 301 dari URL website lama (/home/...) — hanya setelah cutover disetujui
LEGACY_REDIRECTS=false

# --- penjadwalan ---
# true bila job dijalankan oleh cron (npm run jobs:run) dan bukan oleh server web
DISABLE_JOB_AUTORUN=false
# Rahasia untuk memicu /api/payload-jobs/run dari layanan cron eksternal (Authorization: Bearer …)
CRON_SECRET=

# --- email keluar (lupa kata sandi CMS, notifikasi pesan/minat) ---
# Kosong = email TIDAK dikirim (hanya dicatat di log server), walau layar menampilkan "Email Terkirim".
# Alamat penerima notifikasi diatur per sekolah di Pengaturan Sekolah → Notifikasi.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Pengirim; untuk Gmail harus sama dengan SMTP_USER, untuk Brevo/Resend harus alamat di domain terverifikasi.
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Website SMP Nasional KPS

# --- hanya untuk seed pertama (jangan disimpan permanen) ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- sekolah ---
# Zona waktu kini diatur per sekolah (Platform → Sekolah). Nilai ini hanya dipakai migrasi untuk sekolah pertama.
# NEXT_PUBLIC_SCHOOL_TIMEZONE=Asia/Makassar


# --- build Vercel: Preview & produksi pertama (lihat scripts/vercel-build.mjs, scripts/preview-setup.ts) ---
# Preview hanya boleh menyentuh database bila DATABASE_URI Preview menunjuk SALINAN dan variabel ini diisi (Preview saja).
# PREVIEW_DATABASE_IS_COPY=true
# PREVIEW_SCHOOL=kps                      # sekolah yang diberi alamat Preview sebagai domain
# Produksi pertama pada database platform KOSONG; hapus setelah deploy pertama berhasil.
# PLATFORM_BOOTSTRAP=true
# BOOTSTRAP_SUPERADMIN_EMAIL=
# BOOTSTRAP_ADMIN_EMAIL=                  # Admin Teknis sekolah pertama (lihat preview-setup.ts untuk BOOTSTRAP_* lain)
# BOOTSTRAP_APP_DATABASE_URL=
# Skrip create-school/create-superadmin: sandi awal diberikan lewat env (tidak pernah dicetak). Jangan disimpan permanen.
# SCHOOL_ADMIN_PASSWORD=

# --- lain-lain ---
# DEV_HOSTS=www.smpkps.sch.id,localhost   # host yang diizinkan saat `next dev`
# BACKUP_TENANT=kps                       # npm run backup:prod hanya untuk satu sekolah
# CONTACT_NOTIFY_EMAIL= / ADMISSIONS_NOTIFY_EMAIL=   # hanya dibaca migrasi multi-sekolah lama; kini diatur per sekolah di CMS
